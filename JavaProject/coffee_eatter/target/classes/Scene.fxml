<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="255.0" prefWidth="255.0" 
            xmlns="http://javafx.com/javafx/25" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="in.hamshik.Controller">
   <children>
      <!-- Hero Image -->
      <ImageView fx:id="heroView" fitHeight="32.0" fitWidth="32.0" layoutX="112.0" layoutY="112.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@hero.png" />
         </image>
      </ImageView>

      <!-- Coffee Beans -->
      <ImageView fx:id="coffee1View" fitHeight="32.0" fitWidth="32.0" layoutX="0.0" layoutY="0.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@coffeeBean.png" />
         </image>
      </ImageView>
      <ImageView fx:id="coffee2View" fitHeight="32.0" fitWidth="32.0" layoutX="0.0" layoutY="0.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@coffeeBean.png" />
         </image>
      </ImageView>
      <ImageView fx:id="coffee3View" fitHeight="32.0" fitWidth="32.0" layoutX="0.0" layoutY="0.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@coffeeBean.png" />
         </image>
      </ImageView>

      <!-- Villain Image -->
      <ImageView fx:id="villainView" fitHeight="32.0" fitWidth="32.0" layoutX="0.0" layoutY="0.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@villan.png" />
         </image>
      </ImageView>
   </children>
</AnchorPane>
