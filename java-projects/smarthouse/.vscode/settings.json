{
  // Restrict the maximum JVM memory heap size to 512MB or 768MB
  "java.jdt.ls.vmargs": "-Xmx512m -XX:+UseG1GC -XX:+UseStringDeduplication",

  // Disable heavy background CodeLens features (keeps diagnostics & autocomplete active, saves RAM)
  "java.referencesCodeLens.enabled": false,

  // Reduce Maven/Gradle cache footprint if applicable
  "java.maven.downloadSources": false,
  "java.configuration.updateBuildConfiguration": "interactive"
}