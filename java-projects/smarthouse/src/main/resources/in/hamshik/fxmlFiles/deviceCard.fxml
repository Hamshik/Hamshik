<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox fx:controller="in.hamshik.Controller.ManualConnectionCardCtrl" maxHeight="-Infinity"
   maxWidth="363.0" minHeight="-Infinity" minWidth="-Infinity" prefHeight="293.0" prefWidth="363.0"
   styleClass="card" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label styleClass="card-subheading" text="Host Name &amp; IP Adress">
         <VBox.margin>
            <Insets bottom="5.0" />
         </VBox.margin>
      </Label>
      <HBox prefHeight="46.0" prefWidth="339.0">
         <children>
            <TextField fx:id="ipField" alignment="CENTER" prefHeight="37.0" prefWidth="161.0"
               promptText="Enter the IP address" styleClass="device-card" text="192.168.0.XXXX"
               HBox.hgrow="SOMETIMES">
               <HBox.margin>
                  <Insets right="2.0" />
               </HBox.margin>
            </TextField>
            <TextField fx:id="hostNameField" alignment="CENTER" prefHeight="37.0" prefWidth="161.0"
               promptText="Host name (optional)" styleClass="device-card" />
         </children>
      </HBox>
      <Label styleClass="card-subheading" text="Port &amp; NetWork types">
         <VBox.margin>
            <Insets bottom="5.0" />
         </VBox.margin>
      </Label>
      <HBox prefHeight="46.0" prefWidth="339.0">
         <children>
            <TextField fx:id="portField" alignment="CENTER" prefHeight="37.0" prefWidth="161.0"
               promptText="Enter the port number" styleClass="device-card" text="80"
               HBox.hgrow="SOMETIMES">
               <HBox.margin>
                  <Insets right="2.0" />
               </HBox.margin>
            </TextField>
            <TextField fx:id="networkTypeField" alignment="CENTER" prefHeight="37.0"
               prefWidth="161.0" promptText="Network type" styleClass="device-card" text="subnet" />
         </children>
      </HBox>
      <Label styleClass="card-subheading" text="Root Path &amp; Connection Timeout">
         <VBox.margin>
            <Insets bottom="5.0" />
         </VBox.margin>
      </Label>
      <HBox prefHeight="46.0" prefWidth="339.0">
         <children>
            <TextField fx:id="pathField" alignment="CENTER" prefHeight="37.0" prefWidth="161.0"
               promptText="WebSocket path" styleClass="device-card" text="/ws"
               HBox.hgrow="SOMETIMES">
               <HBox.margin>
                  <Insets right="2.0" />
               </HBox.margin>
            </TextField>
            <TextField fx:id="timeoutField" alignment="CENTER" prefHeight="37.0" prefWidth="161.0"
               promptText="Timeout (sec.)" styleClass="device-card" text="5" />
         </children>
      </HBox>
      <Label fx:id="connectionError" wrapText="true" styleClass="card-subheading" text=" " />
      <HBox alignment="CENTER_RIGHT" prefHeight="46.0" prefWidth="339.0">
         <children>
            <Button mnemonicParsing="false" onAction="#cancel" styleClass="ghost-btn" text="Cancel">
               <HBox.margin>
                  <Insets right="5.0" />
               </HBox.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#connect" styleClass="connect-btn"
               text="Connect" />
         </children>
      </HBox>
   </children>
   <stylesheets>
      <URL value="@../styleSheets/dash-card.css" />
      <URL value="@../styleSheets/btn-style.fx.css" />
      <URL value="@../styleSheets/device-card.fx.css" />
      <URL value="@../styleSheets/main.fx.css" />
   </stylesheets>
</VBox>