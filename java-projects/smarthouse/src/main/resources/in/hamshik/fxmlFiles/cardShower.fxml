<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="cardRoot" prefWidth="340.0" spacing="14.0" styleClass="card" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="in.hamshik.Controller.CardCtrl.CardShowerCtrl">
   <children>
      <!-- ===== Header ===== -->
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="varNameLabel" styleClass="card-heading" text="Variable Name" />
                  <Label fx:id="sensorNameLabel" styleClass="card-subheading" text="Sensor / Source" />
               </children>
            </VBox>
            <HBox alignment="CENTER_RIGHT" spacing="6.0">
               <children>
                  <Button fx:id="editBtn" mnemonicParsing="false" onAction="#handleEdit" styleClass="ghost-btn" text="Edit" />
                  <Button fx:id="deleteBtn" mnemonicParsing="false" onAction="#handleDelete" styleClass="ghost-btn, del-btn" text="Delete" />
               </children>
            </HBox>
         </children>
      </HBox>

      <!-- ===== Reading Section ===== -->
      <HBox alignment="CENTER_LEFT" spacing="16.0">
         <children>
            <StackPane maxHeight="72.0" maxWidth="72.0" minHeight="72.0" minWidth="72.0" prefHeight="72.0" prefWidth="72.0">
               <children>
                  <ProgressIndicator fx:id="percentageIndicator" maxHeight="72.0" maxWidth="72.0" minHeight="72.0" minWidth="72.0" prefHeight="72.0" prefWidth="72.0" progress="0.0" style="-fx-progress-color: #00A9A5;" />
                  <Label fx:id="percentageLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #102027;" text="0%" />
               </children>
            </StackPane>
            <VBox alignment="CENTER_LEFT" spacing="6.0">
               <children>
                  <Label fx:id="readingLabel" styleClass="field-label" text="Current value" />
                  <Label fx:id="valueLabel" styleClass="card-heading" text="--" />
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- ===== Access / Permissions ===== -->
      <Label fx:id="permissionLabel" styleClass="card-subheading" text="ACCESS  Read &amp; Write" />
   </children>
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <stylesheets>
      <URL value="@../styleSheets/dash-card.css" />
      <URL value="@../styleSheets/btn-style.fx.css" />
   </stylesheets>
</VBox>
