<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<SplitPane fx:id="root" dividerPositions="0.21120186697782964" prefHeight="756.0" prefWidth="859.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="in.hamshik.Controller.MainCtrl.FileMngCtrl">
   <items>
      <fx:include fx:id="sidebar" source="sidebar.fxml" />

      <AnchorPane fx:id="pageContent" styleClass="app-root">
         <children>
            <AnchorPane fx:id="topbarContainer" prefHeight="56.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="12.0">
               <children>
                  <fx:include fx:id="topbar" source="topbar.fxml" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
               </children>
            </AnchorPane>

            <StackPane styleClass="firmware-page" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="86.0">
               <children>
                  <VBox maxWidth="520.0" spacing="22.0" styleClass="firmware-card">
                     <children>
                        <VBox spacing="7.0">
                           <children>
                              <Label styleClass="firmware-title" text="Firmware upload" />
                              <Label styleClass="firmware-description" text="Choose a compiled .bin firmware file and send it to your ESP32." wrapText="true" />
                           </children>
                        </VBox>

                        <VBox spacing="8.0">
                           <children>
                              <Label styleClass="firmware-field-label" text="Firmware file" />
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <TextField fx:id="firmwarePathField" editable="false" prefHeight="40.0" promptText="Select a .bin file" styleClass="field-input" HBox.hgrow="ALWAYS" />
                                    <Button mnemonicParsing="false" onAction="#browseFirmwareFile" prefHeight="40.0" styleClass="navbuts" text="Browse..." />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <Button fx:id="uploadButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#uploadFirmware" prefHeight="42.0" styleClass="connect-btn" text="Upload firmware" />
                        <Label fx:id="statusLabel" minHeight="20.0" styleClass="firmware-status" text=" " wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </StackPane>
         </children>
      </AnchorPane>
   </items>
   <stylesheets>
      <URL value="@../styleSheets/main.fx.css" />
      <URL value="@../styleSheets/top-sidebar.fx.css" />
      <URL value="@../styleSheets/btn-style.fx.css" />
      <URL value="@../styleSheets/dash-card.fx.css" />
   </stylesheets>
</SplitPane>
