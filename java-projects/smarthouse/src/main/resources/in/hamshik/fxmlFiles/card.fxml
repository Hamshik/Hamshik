<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="cardRoot" maxHeight="-Infinity" maxWidth="351.0" minHeight="-Infinity" minWidth="-Infinity" prefWidth="351.0" styleClass="card" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="in.hamshik.Controller.CardCtrl.CardCtrl">
   <children>
      <!-- ===== Header : icon + title + close ===== -->
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <StackPane minHeight="40.0" minWidth="40.0" styleClass="card-icon-wrap">
               <children>
                  <Label styleClass="card-icon" text="⚡" />
               </children>
            </StackPane>
            <VBox HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="cardTitleLabel" styleClass="card-heading" text="New Variable" />
                  <Label styleClass="card-subheading" text="Configure the device variable" />
               </children>
            </VBox>
            <Button fx:id="closeBtn" mnemonicParsing="false" onAction="#handleClose" styleClass="close-btn" text="✕" />
         </children>
      </HBox>

      <!-- ===== Body ===== -->
      <VBox spacing="18.0">
         <children>
            <!-- Sensor / Actuator -->
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="field-label" text="Sensor / Actuator" />
                  <TextField fx:id="sensorField" promptText="Enter the Sensor's name or Actuator" styleClass="field-input" />
               </children>
            </VBox>

            <!-- Variable Name (autocomplete → auto-fills Type and Permission below) -->
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="field-label" text="Variable Name" />
                  <TextField fx:id="varNameField" promptText="e.g. myVariable" styleClass="field-input" />
               </children>
            </VBox>

            <!-- Data Type — filled automatically by ESP -->
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="field-label" text="Data Type" />
                  <Button fx:id="typeInfoLabel" mnemonicParsing="false" mouseTransparent="true" styleClass="navbuts" text="--Select Variable--" />
               </children>
            </VBox>

            <!-- Permission — filled automatically by ESP -->
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="field-label" text="Permission" />
                  <Button fx:id="permissionInfoLabel" mnemonicParsing="false" mouseTransparent="true" styleClass="navbuts" text="--Select Variable--" />
               </children>
            </VBox>

            <!-- Range -->
            <VBox prefHeight="60.0" prefWidth="331.0">
               <children>
                  <Label styleClass="field-label" text="Range" />
                  <HBox prefHeight="35.0" prefWidth="331.0" VBox.vgrow="SOMETIMES">
                     <children>
                        <TextField fx:id="rangeFrom" prefHeight="33.0" prefWidth="131.0" promptText="From" styleClass="field-input" HBox.hgrow="SOMETIMES">
                           <HBox.margin>
                              <Insets />
                           </HBox.margin>
                           <padding>
                              <Insets right="2.0" />
                           </padding>
                        </TextField>
                        <TextField fx:id="rangeTo" prefHeight="33.0" prefWidth="157.0" promptText="To" styleClass="field-input" HBox.hgrow="SOMETIMES">
                           <HBox.margin>
                              <Insets left="10.0" />
                           </HBox.margin></TextField>
                     </children>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>
         </children>
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
      </VBox>

      <!-- ===== Footer actions ===== -->
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleCancel" styleClass="ghost-btn" text="Cancel" />
            <Button fx:id="saveBtn" mnemonicParsing="false" onAction="#handleSave" styleClass="connect-btn" text="Save Variable" />
         </children>
         <VBox.margin>
            <Insets top="22.0" />
         </VBox.margin>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <stylesheets>
      <URL value="@../styleSheets/dash-card.css" />
      <URL value="@../styleSheets/btn-style.fx.css" />
   </stylesheets>
</VBox>
