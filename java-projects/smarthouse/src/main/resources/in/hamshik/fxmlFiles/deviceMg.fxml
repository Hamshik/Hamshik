<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<SplitPane fx:id="root" dividerPositions="0.21120186697782964" prefHeight="756.0" prefWidth="859.0"
   xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="in.hamshik.Controller.DeviceMngCtrl">
   <items>
      <fx:include fx:id="sidebar" source="sidebar.fxml" />

      <AnchorPane fx:id="pageContent" layoutX="10.0" layoutY="10.0" prefHeight="754.0"
         prefWidth="580.0">
         <children>
            <AnchorPane fx:id="topbarContainer" prefHeight="56.0" AnchorPane.leftAnchor="20.0"
               AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="12.0">
               <children>
                  <fx:include fx:id="topbar" source="topbar.fxml" AnchorPane.bottomAnchor="0.0"
                     AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                     AnchorPane.topAnchor="0.0" />
               </children>
            </AnchorPane>

            <Label fx:id="statusLabel" layoutX="20.0" layoutY="125.0" styleClass="modal-title"
               text=" " AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="125.0" />
            <ProgressIndicator fx:id="loadingSpinner" layoutX="627.0" layoutY="124.0"
               maxHeight="24.0" maxWidth="24.0" prefHeight="24.0" prefWidth="24.0" visible="false"
               AnchorPane.rightAnchor="24.0" AnchorPane.topAnchor="124.0" />

            <!-- Discovered devices are rendered in this scrollable list. -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" layoutX="14.0" layoutY="158.0"
               prefHeight="580.0" prefWidth="648.0" styleClass="board"
               AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="14.0"
               AnchorPane.rightAnchor="13.0" AnchorPane.topAnchor="158.0">
               <content>
                  <VBox fx:id="deviceListContainer" spacing="8.0" />
               </content>
            </ScrollPane>

            <Button layoutX="466.0" layoutY="81.0" mnemonicParsing="false" styleClass="navbuts"
               text="Manage Other WiFi Networks" AnchorPane.rightAnchor="13.0"
               AnchorPane.topAnchor="81.0" />
            <Button layoutX="20.0" layoutY="81.0" mnemonicParsing="false" onAction="#wifiShow"
               styleClass="navbuts" text="Manage Bluetooth" AnchorPane.leftAnchor="20.0"
               AnchorPane.topAnchor="81.0" />
         </children>
      </AnchorPane>
   </items>
   <stylesheets>
      <URL value="@../styleSheets/main.fx.css" />
      <URL value="@../styleSheets/btn-style.fx.css" />
      <URL value="@../styleSheets/device-card.fx.css" />
      <URL value="@../styleSheets/top-sidebar.fx.css" />
   </stylesheets>
</SplitPane>