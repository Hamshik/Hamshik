<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.ImagePattern?>
<?import javafx.scene.shape.Circle?>

<AnchorPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="503.0" prefWidth="399.0" stylesheets="@main.fx.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="in.hamshik.Controller">
   <children>
      <!-- Base Main Content (will be blurred when modal is open) -->
      <AnchorPane fx:id="mainContent" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Button fx:id="wifiBut" layoutX="216.0" layoutY="16.0" mnemonicParsing="false" onAction="#wifiShow" styleClass="modern-wifi-pill" text="Disconnected">
               <graphic>
                  <Circle radius="11.0">
                     <fill>
                        <ImagePattern>
                           <image>
                              <Image url="@wifi.png" />
                           </image>
                        </ImagePattern>
                     </fill>
                  </Circle>
               </graphic>
            </Button>
         </children>
      </AnchorPane>

      <!-- Full-screen Modal Overlay (hidden initially) -->
      <StackPane fx:id="modalOverlay" styleClass="modal-overlay" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <!-- Smooth Rounded Popup Box (Phone style) -->
            <VBox fx:id="modalCard" alignment="TOP_CENTER" maxHeight="380.0" maxWidth="340.0" prefHeight="380.0" prefWidth="340.0" spacing="12.0" styleClass="modal-card">
               <children>
                  <!-- Header: Title, Spinner, and Close Button -->
                  <HBox alignment="CENTER_LEFT" prefHeight="36.0" spacing="8.0">
                     <children>
                        <Label styleClass="modal-title" text="Available Devices" />
                        <ProgressIndicator fx:id="loadingSpinner" prefHeight="18.0" prefWidth="18.0" />
                        <HBox HBox.hgrow="ALWAYS" />
                        <Button fx:id="closeBtn" mnemonicParsing="false" onAction="#closeModal" styleClass="close-btn" text="✕" />
                     </children>
                  </HBox>

                  <Label fx:id="statusLabel" styleClass="modal-subtitle" text="Scanning local network for ESP32..." />

                  <!-- Scrollable list of found devices -->
                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="260.0" styleClass="device-scroll-pane" vbarPolicy="AS_NEEDED">
                     <content>
                        <VBox fx:id="deviceListContainer" spacing="8.0">
                           <padding>
                              <Insets bottom="4.0" left="2.0" right="2.0" top="4.0" />
                           </padding>
                        </VBox>
                     </content>
                  </ScrollPane>
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>
