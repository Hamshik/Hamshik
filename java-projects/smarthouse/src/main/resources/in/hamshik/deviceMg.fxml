<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<StackPane prefHeight="750.0" prefWidth="729.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="in.hamshik.Controller.DeviceMngController">
   <children>
      <SplitPane fx:id="pageContent" dividerPositions="0.2746431757359501">
         <items>
            <VBox prefWidth="140.0" styleClass="sidebar">
               <children>
                  <HBox styleClass="sidebar-logo">
                     <children>
                        <Circle fill="#00A9A5" radius="7.0" />
                        <Label styleClass="sidebar-logo-text" text="IoT Cloud" />
                     </children>
                  </HBox>
                  <VBox styleClass="sidebar-nav">
                     <children>
                        <Button mnemonicParsing="false" onAction="#showDashboard" styleClass="sidebar-item" text="▦   Dashboard" />
                        <Button mnemonicParsing="false" onAction="#showDevices" styleClass="sidebar-item, sidebar-item-active" text="◉   Devices" />
                        <Button mnemonicParsing="false" styleClass="sidebar-item" text="⚙   Things" />
                     </children>
                  </VBox>
                  <HBox VBox.vgrow="ALWAYS" />
                  <Label styleClass="sidebar-footer" text="ESP32 · v1.0" />
               </children>
            </VBox>
            <AnchorPane prefWidth="595.0" styleClass="topbar">
               <children>
                  <Label styleClass="topbar-title" text="Device Manager" AnchorPane.leftAnchor="24.0" AnchorPane.topAnchor="17.0" />
                  <Button fx:id="wifiBut" mnemonicParsing="false" onAction="#wifiShow" styleClass="disconnect-btn" text="Disconnected" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="12.0">
                     <graphic>
                        <Group>
                           <children>
                              <SVGPath content="M2 7.5 C7.5 2.5 16.5 2.5 22 7.5 M5 11 C9 7.4 15 7.4 19 11 M9 14.5 C10.7 13 13.3 13 15 14.5" fill="TRANSPARENT" stroke="WHITE" strokeLineCap="ROUND" strokeWidth="2.4" />
                              <Circle centerX="12" centerY="18" fill="WHITE" radius="1.4" />
                           </children>
                        </Group>
                     </graphic>
                  </Button>
                  <VBox layoutX="10.0" layoutY="107.0" prefHeight="624.0" prefWidth="510.0" styleClass="board" />
                  <Button layoutX="322.0" layoutY="69.0" mnemonicParsing="false" styleClass="navbuts" text="Manage Other WiFi Networks" />
                  <Button layoutX="10.0" layoutY="69.0" mnemonicParsing="false" styleClass="navbuts" text="Manage Bluetooth" />
               </children>
            </AnchorPane>
         </items>
      </SplitPane>
      <StackPane fx:id="modalOverlay" managed="false" styleClass="modal-overlay" visible="false">
         <children>
            <VBox fx:id="modalCard" maxHeight="520.0" maxWidth="460.0" spacing="14.0" styleClass="modal-card">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <VBox HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="modal-title" text="Connect to an ESP32" />
                              <Label styleClass="modal-subtitle" text="Devices on your local network" />
                           </children>
                        </VBox>
                        <Button mnemonicParsing="false" onAction="#closeModal" styleClass="close-btn" text="×" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <ProgressIndicator fx:id="loadingSpinner" maxHeight="20.0" maxWidth="20.0" prefHeight="20.0" prefWidth="20.0" />
                        <Label fx:id="statusLabel" styleClass="modal-subtitle" text="Scanning local network for ESP32..." />
                     </children>
                  </HBox>
                  <ScrollPane fitToWidth="true" prefHeight="320.0" styleClass="device-scroll-pane">
                     <content>
                        <VBox fx:id="deviceListContainer" spacing="8.0" />
                     </content>
                  </ScrollPane>
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
   <stylesheets>
      <URL value="@main.fx.css" />
      <URL value="@btn-style.fx.css" />
   </stylesheets>
</StackPane>
