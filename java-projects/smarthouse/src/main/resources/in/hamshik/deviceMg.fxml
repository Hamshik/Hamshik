<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<SplitPane fx:id="root" dividerPositions="0.27" prefHeight="756.0" prefWidth="859.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="in.hamshik.Controller.DeviceMngController">
   <items>
      <!-- Placeholder for Sidebar -->
      <AnchorPane fx:id="sidebarContainer" />
      
      <AnchorPane fx:id="pageContent" prefHeight="602.0" prefWidth="405.0">
         <children>
            <!-- Placeholder for Topbar -->
            <AnchorPane fx:id="topbarContainer" />
            
            <!-- Main Device List Container -->
            <VBox fx:id="deviceListContainer" minHeight="0.0" minWidth="0.0" prefHeight="0.0" prefWidth="0.0" styleClass="board" AnchorPane.bottomAnchor="11.0" AnchorPane.leftAnchor="11.0" AnchorPane.rightAnchor="11.0" AnchorPane.topAnchor="163.0" />
            
            <!-- Modal Card containing loading elements referenced in DeviceMngController -->
            <VBox fx:id="modalCard" layoutX="150.0" layoutY="180.0" prefHeight="250.0" prefWidth="300.0" styleClass="modal-card" visible="false">
               <children>
                  <Label fx:id="statusLabel" styleClass="modal-title" text="Scanning for devices..." />
                  <ProgressIndicator fx:id="loadingSpinner" prefHeight="50.0" prefWidth="50.0" />
               </children>
            </VBox>

            <Button mnemonicParsing="false" styleClass="navbuts" text="Manage Other WiFi Networks"
                    AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="111.0" />
            <Button mnemonicParsing="false" onAction="#wifiShow" styleClass="navbuts" text="Manage Bluetooth"
                    AnchorPane.leftAnchor="14.0" AnchorPane.topAnchor="111.0" />
         </children>
      </AnchorPane>
   </items>
   <stylesheets>
      <URL value="@main.fx.css" />
      <URL value="@btn-style.fx.css" />
   </stylesheets>
</SplitPane>
