#!/bin/bash
# Create central config directory
mkdir -p .configs/java-project

# Move .gitignore and optional .list.txt into configs
[ -f .gitignore ] && mv .gitignore .configs/
[ -f .list.txt ] && mv .list.txt .configs/

# Move .vscode inside configs
mv java-project/.vscode .configs/java-project/

# Symlink back .vscode so VS Code still works
ln -s ../.configs/java-project/.vscode java-project/.vscode

# Move lib folder into configs
mv java-project/lib .configs/java-project/

# Symlink lib back into java-project
ln -s ../.configs/java-project/lib java-project/lib
